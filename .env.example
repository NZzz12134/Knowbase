# ===== Database (MySQL 8.0+) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=rag_user
MYSQL_PASSWORD=rag_pass_2024
MYSQL_DB=rag_qa
# Docker Compose only; replace before deployment. Native MySQL uses its existing root password.
MYSQL_ROOT_PASSWORD=change-me-before-deployment

# ===== Redis (Memurai) =====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== JWT =====
# Production: change to a random long string
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== Personal model encryption =====
# Optional dedicated encryption secret. API and worker must use the same value.
# If empty, JWT_SECRET is used. Keep this secret when restoring the database.
MODEL_CONFIG_ENCRYPTION_KEY=
# Model names, URLs and API keys are configured per account in the web UI.
# There are no installation-level default models. Legacy model env vars are ignored.

# ===== Generation parameters =====
LLM_TEMPERATURE=0.3
# Thinking tokens may count toward this limit; long code answers need a larger budget.
LLM_MAX_TOKENS=8192

# ===== Retrieval =====
RETRIEVAL_MODE=hybrid          # hybrid | vector
VECTOR_TOP_K=10
BM25_TOP_K=10
RRF_K=60
SCORE_THRESHOLD=0.35
RERANK_TOP_N=5

# ===== Chroma =====
# embedded: dev mode (single process, Celery must use -P solo)
# server:   production mode (chroma server in docker)
CHROMA_MODE=embedded
CHROMA_HOST=localhost
CHROMA_PORT=8001
# server 模式 + 生产 compose 必填：随机长字符串，如 openssl rand -hex 32
CHROMA_TOKEN=
CHROMA_PERSIST_DIR=storage/chroma

# ===== File storage =====
STORAGE_DIR=storage/documents
MAX_UPLOAD_MB=50

# ===== Cache TTL (seconds) =====
EMBED_CACHE_TTL=2592000       # 30 days
CHAT_CACHE_TTL=3600           # 1 hour
LOGIN_LOCK_SECONDS=900        # 15 min lock after 5 failures

# ===== CORS (frontend dev port) =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
